# Copy to .env and adjust. Restart `npm run dev` after changes.

# FastAPI base URL (used by riskApi + ElevenLabs client tools). IPv4 avoids some localhost → ::1 issues.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional legacy name; ignored if VITE_BACKEND_URL is set.
# VITE_API_BASE=http://127.0.0.1:8000

# --- ElevenLabs (voice on /assessment) ---
# Default: WebSocket — usually no key needed.
#
# For WebRTC in dev only: set ELEVENLABS_API_KEY (Vite proxy adds xi-api-key to token requests).
# ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_CONNECTION=webrtc
#
# Optional: WebSocket auth for protected agents (exposed in browser bundle — prefer server-side in production).
# VITE_ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_AGENT_ID=agent_...
